#!/usr/bin/env bash
set -euo pipefail

branch="${1:-master}"
dotfiles_home="${DOTHOME:-$HOME/dotfiles}"

if [[ ! -e "$dotfiles_home/.git" ]]; then
  if ! git clone --branch "$branch" --recurse-submodules \
    git@github.com:stephenprater/dotfiles.git \
    "$dotfiles_home"; then
    git clone --branch "$branch" --recurse-submodules \
      ssh://gitpersonal/stephenprater/dotfiles.git \
      "$dotfiles_home"
  fi
fi

printf '[dotfiles] running repository bootstrap\n'
exec "$dotfiles_home/script/bootstrap"
