#!/usr/bin/env bash
set -euo pipefail

log() {
  printf '[bootstrap] %s\n' "$*" >&2
}

brew_shellenv() {
  local brew_bin
  for brew_bin in \
    "$(command -v brew 2>/dev/null || true)" \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew \
    "$HOME/.linuxbrew/bin/brew"; do
    if [ -n "$brew_bin" ] && [ -x "$brew_bin" ]; then
      eval "$("$brew_bin" shellenv)"
      return
    fi
  done
  return 1
}

ensure_brew() {
  if brew_shellenv; then
    return
  fi

  log "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew_shellenv
}

main() {
  local dotfiles_home="${DOTFILES_HOME:-${DOTHOME:-$HOME/dotfiles}}"
  local dotfiles_remote="${1:-}"

  if [ ! -d "$dotfiles_home/.git" ] && [ ! -d "$dotfiles_home/.jj" ]; then
    if [ -z "$dotfiles_remote" ]; then
      printf 'usage: %s <dotfiles-git-url>\n' "${0##*/}" >&2
      exit 2
    fi

    log "cloning $dotfiles_remote into $dotfiles_home"
    git clone "$dotfiles_remote" "$dotfiles_home"
  fi

  ensure_brew
  brew tap --custom-remote prater/dotfiles "$dotfiles_home"
  HOMEBREW_NO_REQUIRE_TAP_TRUST=1 brew prater bootstrap
}

main "$@"
